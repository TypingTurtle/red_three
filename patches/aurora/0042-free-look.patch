diff --git a/lib/gx/shader_info.cpp b/lib/gx/shader_info.cpp
index dae53e5..d0bc84f 100644
--- a/lib/gx/shader_info.cpp
+++ b/lib/gx/shader_info.cpp
@@ -499,6 +499,26 @@ static Mat4x4<float> draw_projection() noexcept {
     proj.m2 = proj.m2 + proj.m3;
   }
   apply_widescreen_scale(proj);
+  // Free look: the scene's camera turned by the head (view space: p' = Rx(-pitch) Ry(yaw) p)
+  if ((g_gxState.freeLookYaw != 0.f || g_gxState.freeLookPitch != 0.f) && g_gxState.projType != GX_ORTHOGRAPHIC &&
+      std::abs(g_gxState.proj.m0[2]) < 0.05f && std::abs(g_gxState.proj.m1[2]) < 0.05f &&
+      !copy_source_viewport(g_gxState.logicalViewport)) {
+    const float cy = std::cos(g_gxState.freeLookYaw), sy = std::sin(g_gxState.freeLookYaw);
+    const float cp = std::cos(-g_gxState.freeLookPitch), sp = std::sin(-g_gxState.freeLookPitch);
+    // R = Rx(-pitch) * Ry(yaw), rows
+    const Vec4<float> r0{cy, 0.f, sy, 0.f};
+    const Vec4<float> r1{sp * sy, cp, -sp * cy, 0.f};
+    const Vec4<float> r2{-cp * sy, sp, cp * cy, 0.f};
+    const Vec4<float> r3{0.f, 0.f, 0.f, 1.f};
+    const auto mul = [&](const Vec4<float>& m) {
+      return r0 * Vec4{m[0], m[0], m[0], m[0]} + r1 * Vec4{m[1], m[1], m[1], m[1]} + r2 * Vec4{m[2], m[2], m[2], m[2]} +
+             r3 * Vec4{m[3], m[3], m[3], m[3]};
+    };
+    proj.m0 = mul(proj.m0);
+    proj.m1 = mul(proj.m1);
+    proj.m2 = mul(proj.m2);
+    proj.m3 = mul(proj.m3);
+  }
   return proj;
 }
 
