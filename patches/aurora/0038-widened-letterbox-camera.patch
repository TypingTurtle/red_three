--- a/lib/gx/command_processor.cpp
+++ b/lib/gx/command_processor.cpp
@@ -463,6 +463,18 @@
   // (cards and movies stopped short of the top and bottom).
   const bool letterboxCamera =
       v > 1.f && p0 != 0.f && std::abs(std::abs(p2 / p0) / (logicalAspect * v) - 1.f) < 0.002f;
+  // A letterboxed frame's camera the game widened itself to the display (AuroraSetWidenedAspects:
+  // Rebel Strike's turn-around at a map's edge, so that it also culls for the wider view): it
+  // already has the 1 / r the stretch below would give, so it keeps its shape (and its off-center
+  // shift gets the 1 / r the stretch gives it).
+  if (v > 1.f && !letterboxCamera && p0 != 0.f && k / v > 1.f) {
+    for (u32 i = 0; i < g_gxState.widenedAspectCount; ++i) {
+      if (std::abs(std::abs(p2 / p0) / g_gxState.widenedAspects[i] - 1.f) < 0.002f &&
+          std::abs(std::abs(p2 / p0) / (logicalAspect * k) - 1.f) < 0.01f) {
+        return {1.f, 1.f, v / k, xAdd};
+      }
+    }
+  }
   if (!letterboxCamera && p0 != 0.f && std::abs(std::abs(p2 / p0) / (logicalAspect * k) - 1.f) < 0.01f) {
     return {1.f, 1.f / v, 1.f / k, xAdd};
   }
