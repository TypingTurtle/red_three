+    // copy into a larger one at a row that is not a multiple of 4)
+    const u8 flags = reader.read<u8>();
+    g_gxState.texCopyNative = (flags & 2) != 0;
+    g_gxState.texCopyRowOffset = (flags >> 2) & 3;
     g_gxState.texCopyDstWide = true;
